# Airflow Variables the OSDU DAGs read, as AIRFLOW_VAR_<NAME> environment
# variables on every Airflow container (ADR-044). One map: an add-on family
# that needs another service URL adds it here. Rendered worker templates read
# the same Variables through Jinja (render-values.yaml).
AIRFLOW_VAR_ENV_VARS_ENABLED=true
AIRFLOW_VAR_NAMESPACE=platform
AIRFLOW_VAR_CORE__SERVICE__STORAGE__URL=http://storage.osdu.svc.cluster.local/api/storage/v2
AIRFLOW_VAR_CORE__SERVICE__SEARCH__URL=http://search.osdu.svc.cluster.local/api/search/v2
AIRFLOW_VAR_CORE__SERVICE__SCHEMA__URL=http://schema.osdu.svc.cluster.local/api/schema-service/v1
AIRFLOW_VAR_CORE__SERVICE__WORKFLOW__URL=http://workflow.osdu.svc.cluster.local/api/workflow/v1
AIRFLOW_VAR_CORE__SERVICE__ENTITLEMENTS__URL=http://entitlements.osdu.svc.cluster.local/api/entitlements/v2
AIRFLOW_VAR_CORE__SERVICE__PARTITION__URL=http://partition.osdu.svc.cluster.local/api/partition/v1
AIRFLOW_VAR_CORE__SERVICE__LEGAL__URL=http://legal.osdu.svc.cluster.local/api/legal/v1
AIRFLOW_VAR_CORE__SERVICE__UNIT__URL=http://unit.osdu.svc.cluster.local/api/unit
# The file client appends /v2/files/...
AIRFLOW_VAR_CORE__SERVICE__FILE__URL=http://file.osdu.svc.cluster.local/api/file
AIRFLOW_VAR_CORE__INGESTION__BATCH_COUNT=3
AIRFLOW_VAR_CORE__CONFIG__SHOW_SKIPPED_IDS=True
